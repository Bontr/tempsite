---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const fallbackSrc = `${baseUrl}images/hero-fallback.png`;
---
<div class="scene" data-parallax-scene aria-hidden="true">
  <img class="scene__fallback" src={fallbackSrc} alt="" decoding="async" fetchpriority="high" />
  <canvas class="scene__canvas" data-scene-canvas></canvas>
  <div class="scene__vignette"></div>
</div>

<script>
  import '../../scripts/scene/index.ts';
</script>
