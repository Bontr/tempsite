<div class="home__sections">
  <section class="home-section hero" aria-labelledby="hero-title">
    <div class="hero__brand" aria-label="Bontr">BONTR</div>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        <span>BONTR</span>
        <em>SHAPES</em>
        <span>TOMORROW</span>
      </h1>
      <p class="hero__lede">Bontr prototype web design</p>
      <button class="hero__cta" type="button" data-explore-cta aria-controls="field">
        <span>Explore Bontr</span>
        <span class="hero__cta-arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </section>

  <section class="home-section field" id="field" aria-labelledby="field-title">
    <div class="field__copy">
      <p class="field__eyebrow">02 /</p>
      <h2 id="field-title" class="field__title">
        <span>A WIDER</span>
        <span>FIELD OF</span>
        <em>POSSIBILITY</em>
      </h2>
      <p class="field__lede">Bontr brings together ideas, people and technology to explore what's next — expanding human potential beyond the visible.</p>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollToPlugin);

  const exploreCta = document.querySelector<HTMLButtonElement>('[data-explore-cta]');
  const fieldSection = document.querySelector<HTMLElement>('#field');
  let exploreTween: gsap.core.Tween | null = null;

  const setTraveling = (active: boolean) => {
    document.documentElement.classList.toggle('explore-traveling', active);
  };

  const finishExplore = () => {
    setTraveling(false);
    exploreTween = null;
  };

  const travelToField = () => {
    if (!exploreCta || !fieldSection) return;
    exploreTween?.kill();
    const targetY = fieldSection.getBoundingClientRect().top + window.scrollY;
    setTraveling(true);
    exploreTween = gsap.to(window, {
      duration: 2.3,
      ease: 'power1.inOut',
      scrollTo: { y: targetY, autoKill: true, onAutoKill: finishExplore },
      overwrite: true,
      onComplete: () => {
        history.replaceState(null, '', '#field');
        finishExplore();
      },
      onInterrupt: finishExplore,
    });
  };

  if (exploreCta && fieldSection) {
    exploreCta.dataset.exploreReady = 'true';
    exploreCta.addEventListener('click', travelToField);
  }
</script>
